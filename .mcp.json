{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--browser", "chromium",
        "--headless",
        "--isolated",
        "--timeout-action", "15000",
        "--output-dir", ".playwright"
      ]
    }
  }
}
